# =============================================================
# Environment example for Einsmart
# =============================================================

# ---> CONEXIÓN PARA SERVIDORES LOCALES <---
MONGO_URI=mongodb://einsmart_app:apppass2024@einsmart_mongodb:27017/Einsmart?authSource=admin

# ---> CONEXIÓN EN LA NUBE (REFERENCIA PARA VERCEL) <---
# MONGO_URI_CLOUD=mongodb+srv://yguajardov:maquina123@comercioelectronico.c6vj7t7.mongodb.net/?Einsmart=ComercioElectronico
# (Recuerda que en produccion/Vercel es recomendable definir MONGO_URI directamente en el Dashboard).

# Server port
PORT=5000

# Webpay / Transbank shared secret used to verify webhook signatures
# For local testing you can leave this empty to bypass verification.
WEBPAY_SECRET=your_webpay_shared_secret
TRANSBANK_SHARED_SECRET=your_transbank_shared_secret

# Optional keys for other providers used by the app
FLOW_API_KEY=
MERCADOLIBRE_ACCESS_TOKEN=

NODE_ENV=development
